## System

NAME=SteamHeadless
TZ=Europe/Paris
USER_LOCALES="fr_FR.UTF-8 UTF-8"
DISPLAY=:0
SHM_SIZE=2G
HOME_DIR=/opt/container-data/steam-headless/home
GAMES_DIR=/mnt/games

# User

PUID=$UID
PGID=$UID
UMASK=000
USER_PASSWORD=password

# Mode

MODE=secondary

# Services

ENABLE_STEAM=true
STEAM_ARGS=-silent
